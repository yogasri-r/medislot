# Environment Variables for MediSlot
PROJECT_NAME="MediSlot"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-very-secure-random-32-byte-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL for Production, SQLite for Local Testing)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medislot"
# DATABASE_URL="sqlite:///./medislot.db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Gemini LLM API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# System Config
SINGLE_HOSPITAL_MODE=false
DEFAULT_TIMEZONE="Asia/Kolkata"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
